PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:moksha123@localhost:5432/drainwatch
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Uses the configured Mangaluru and Bantwal taluk service-area polygons.
SERVICE_AREAS_GEOJSON=./data/service-areas.geojson
GEOCODER_USER_AGENT=DrainWatch/1.0 (contact: your-email@example.com)

# Configure these for the one ward/Panchayat selected for your project.
AREA_NAME=Your Ward Name
AREA_LATITUDE=12.9141
AREA_LONGITUDE=74.8560

# Optional: Open-Meteo uses no API key for basic forecast access.
